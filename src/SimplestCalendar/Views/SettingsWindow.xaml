<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SimplestCalendar.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings — Simplest Calendar">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RequestedTheme="Dark" Padding="0">
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Calendar" Tag="calendar" />
                <NavigationViewItem Content="General" Tag="general" />
                <NavigationViewItem Content="Appearance" Tag="appearance" />
                <NavigationViewItem Content="About / Data" Tag="about" />
            </NavigationView.MenuItems>

            <ScrollViewer Padding="24">
                <Grid>
                    <StackPanel x:Name="CalendarPanel" Spacing="16" Visibility="Visible">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Calendar" />
                        <ComboBox
                            Width="220"
                            Header="First day of week"
                            ItemsSource="{x:Bind ViewModel.WeekDays}"
                            SelectedItem="{x:Bind ViewModel.FirstDayOfWeek, Mode=TwoWay}" />
                        <TextBox
                            Header="Month title format (MMMM, MMM, MM, yyyy, yy)"
                            PlaceholderText="MMMM"
                            Text="{x:Bind ViewModel.MonthTitleFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock x:Name="PreviewText" />
                    </StackPanel>

                    <StackPanel x:Name="GeneralPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="General" />
                        <ToggleSwitch
                            Header="Launch at Windows startup"
                            IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Default is off. Uses a per-user Run registry entry (unpackaged)."
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Header="Close app on exit"
                            IsOn="{x:Bind ViewModel.CloseAppOnExit, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBlock
                            Opacity="0.7"
                            Text="Default is off. When off, closing the window keeps the app running in the tray — use Quit on the tray menu to exit fully. When on, the close button quits the app."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Appearance" />
                        <RadioButton Content="{x:Bind ViewModel.ThemeLabel}" IsChecked="True" IsEnabled="True" />
                        <RadioButton Content="Light (coming later)" IsEnabled="False" />
                        <RadioButton Content="Follow system (coming later)" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About / Data" />
                        <TextBlock Text="Simplest Calendar" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Offline month whiteboard for Windows 11." Opacity="0.8" />
                        <TextBlock Text="{x:Bind ViewModel.AppVersionText}" />
                        <TextBlock Text="{x:Bind ViewModel.SchemaVersionText}" />
                        <TextBlock Text="Portable data folder:" />
                        <TextBox
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.DataPath}"
                            TextWrapping="Wrap" />
                        <Button Click="OpenDataFolder_Click" Content="Open data folder" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <Border
            VerticalAlignment="Bottom"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.8"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="SettingsSaveButton"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
