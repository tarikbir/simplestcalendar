<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimplestCalendar.Views.DayEntriesListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimplestCalendar.ViewModels"
    mc:Ignorable="d"
    MinWidth="400"
    MinHeight="200"
    RequestedTheme="Dark">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Opacity="0.7"
            Text="Select an entry. Middle-click a highlighted row to delete quickly."
            TextWrapping="Wrap" />

        <ListView
            x:Name="EntriesList"
            Grid.Row="1"
            MaxHeight="360"
            AutomationProperties.AutomationId="DayEntriesList"
            IsItemClickEnabled="True"
            ItemClick="EntriesList_ItemClick"
            ItemsSource="{x:Bind Items}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DayEntryListItem">
                    <Grid Padding="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Click="DeleteButton_Click"
                            Content="Delete"
                            Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="2"
            Opacity="0.6"
            Text="Click a row to edit." />
    </Grid>
</UserControl>
