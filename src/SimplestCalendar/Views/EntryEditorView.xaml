<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimplestCalendar.Views.EntryEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="440"
    RequestedTheme="Dark">

    <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="4" Spacing="12">
            <TextBlock
                x:Name="ValidationText"
                Foreground="#FF6B6B"
                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="NoteBox"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="EntryNoteBox"
                    Header="Note"
                    MinHeight="96"
                    Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Margin="0,28,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="EntryEmojiButton"
                    Click="EmojiButton_Click"
                    Content="😀"
                    ToolTipService.ToolTip="Windows emoji panel" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EntryHasStartTimeCheck"
                    Content="Start time"
                    IsChecked="{x:Bind ViewModel.HasStartTime, Mode=TwoWay}" />
                <TimePicker
                    x:Name="StartTimePicker"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EntryStartTimePicker"
                    ClockIdentifier="24HourClock"
                    MinuteIncrement="5"
                    SelectedTime="{x:Bind ViewModel.StartTime, Mode=TwoWay}"
                    TimeChanged="StartTimePicker_TimeChanged" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EntryHasDurationCheck"
                    Content="Timed duration"
                    IsChecked="{x:Bind ViewModel.HasDuration, Mode=TwoWay}" />
                <NumberBox
                    x:Name="DurationHoursBox"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="EntryDurationHours"
                    Header="Hours"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="DurationHoursBox_ValueChanged" />
                <NumberBox
                    x:Name="DurationMinutesBox"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="EntryDurationMinutes"
                    Header="Minutes"
                    Maximum="59"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="DurationMinutesBox_ValueChanged" />
            </Grid>

            <CheckBox
                AutomationProperties.AutomationId="EntryStarCheck"
                Content="★ Important"
                IsChecked="{x:Bind ViewModel.IsStarred, Mode=TwoWay}" />

            <CheckBox
                AutomationProperties.AutomationId="EntryReminderCheck"
                Content="Reminder"
                IsChecked="{x:Bind ViewModel.ReminderEnabled, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="Lead minutes:" />
                <Button Click="LeadPreset_Click" Content="5" Tag="5" />
                <Button Click="LeadPreset_Click" Content="10" Tag="10" />
                <Button Click="LeadPreset_Click" Content="15" Tag="15" />
                <Button Click="LeadPreset_Click" Content="30" Tag="30" />
                <NumberBox
                    x:Name="LeadBox"
                    Width="100"
                    Minimum="1"
                    ValueChanged="LeadBox_ValueChanged" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
