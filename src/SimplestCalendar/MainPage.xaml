<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SimplestCalendar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimplestCalendar.ViewModels"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                AutomationProperties.AutomationId="PrevMonthButton"
                Command="{x:Bind ViewModel.GoPreviousCommand}"
                Content="←"
                IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="TodayButton"
                Command="{x:Bind ViewModel.GoTodayCommand}"
                Content="Today" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="NextMonthButton"
                Command="{x:Bind ViewModel.GoNextCommand}"
                Content="→"
                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />

            <TextBlock
                Grid.Column="3"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontFamily="ms-appx:///Assets/Fonts/Fraunces-Variable.ttf#Fraunces"
                FontSize="28"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Button
                Grid.Column="4"
                Width="48"
                Height="40"
                Padding="0"
                AutomationProperties.AutomationId="SettingsButton"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.WeekdayHeaders}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="7"
                    MinColumnSpacing="4"
                    MinRowSpacing="4"
                    Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Border
            x:Name="MonthHost"
            Grid.Row="2"
            SizeChanged="MonthHost_SizeChanged">
            <ItemsRepeater
                x:Name="MonthGrid"
                ItemsSource="{x:Bind ViewModel.Days}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        x:Name="MonthGridLayout"
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="7"
                        MinColumnSpacing="4"
                        MinItemHeight="88"
                        MinRowSpacing="4"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayCellViewModel">
                        <Border
                            Padding="6"
                            Background="{x:Bind CellBackground, Mode=OneWay}"
                            BorderBrush="#404040"
                            BorderThickness="1"
                            CornerRadius="4"
                            Loaded="DayCell_Loaded"
                            Opacity="{x:Bind OpacityForMonth}"
                            PointerEntered="DayCell_PointerEntered"
                            PointerExited="DayCell_PointerExited"
                            Tag="{x:Bind}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontWeight="{x:Bind TodayWeight}"
                                    Foreground="{x:Bind TodayBrush}"
                                    Text="{x:Bind DayNumber}" />
                                <ScrollViewer
                                    Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Enabled">
                                    <ItemsControl ItemsSource="{x:Bind EntryLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DayEntrySummaryLine">
                                                <Border
                                                    Padding="2,1"
                                                    Margin="0,1"
                                                    Background="{x:Bind LineBackground, Mode=OneWay}"
                                                    CornerRadius="2"
                                                    PointerEntered="EntryLine_PointerEntered"
                                                    PointerExited="EntryLine_PointerExited"
                                                    PointerPressed="EntryLine_PointerPressed"
                                                    RightTapped="EntryLine_RightTapped"
                                                    Tag="{x:Bind}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{x:Bind LineBrush, Mode=OneWay}"
                                                        Text="{x:Bind Label}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        ToolTipService.ToolTip="Right-click to edit · Middle-click to delete" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Border>
    </Grid>
</Page>
