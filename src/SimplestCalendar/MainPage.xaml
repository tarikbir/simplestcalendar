<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SimplestCalendar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimplestCalendar.ViewModels"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="TodayButton"
                Command="{x:Bind ViewModel.GoTodayCommand}"
                Content="Today" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="NextMonthButton"
                Command="{x:Bind ViewModel.GoNextCommand}"
                Content="→"
                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" />
            <Button
                Grid.Column="3"
                AutomationProperties.AutomationId="SettingsButton"
                Click="SettingsButton_Click"
                Content="Settings" />
        </Grid>

        <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.WeekdayHeaders}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="7"
                    MinColumnSpacing="4"
                    MinRowSpacing="4"
                    Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <ItemsRepeater Grid.Row="2" ItemsSource="{x:Bind ViewModel.Days}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="7"
                    MinColumnSpacing="4"
                    MinItemHeight="88"
                    MinRowSpacing="4"
                    Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:DayCellViewModel">
                    <Border
                        Padding="6"
                        Background="{x:Bind CellBackground, Mode=OneWay}"
                        BorderBrush="#404040"
                        BorderThickness="1"
                        CornerRadius="4"
                        Opacity="{x:Bind OpacityForMonth}"
                        PointerEntered="DayCell_PointerEntered"
                        PointerExited="DayCell_PointerExited"
                        RightTapped="DayCell_RightTapped"
                        Tapped="DayCell_Tapped"
                        Tag="{x:Bind}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontWeight="{x:Bind TodayWeight}"
                                Foreground="{x:Bind TodayBrush}"
                                Text="{x:Bind DayNumber}" />
                            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Summaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="11"
                                            Text="{Binding}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </Grid>
</Page>
